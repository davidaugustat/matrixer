{
  "name": "matrixer",
  "version": "1.0.0",
  "description": "A simple finite field calculator with support for matrix and vector math.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "serve:test": "node tests/staticServer.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:logic": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test": "npm run test:logic && npm run build && npm run test:e2e",
    "postinstall": "nuxt prepare"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaugustat/matrixer.git"
  },
  "keywords": [
    "finite field",
    "vector",
    "matrix",
    "math"
  ],
  "author": "David Augustat",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/davidaugustat/matrixer/issues"
  },
  "homepage": "https://github.com/davidaugustat/matrixer#readme",
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "bootstrap": "^5.3.8",
    "katex": "^0.18.6",
    "nuxt": "^4.5.2",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jsdoc": "^64.3.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "serve-handler": "^6.1.7",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
