{
  "name": "matrixer",
  "version": "1.0.0",
  "description": "A simple finite field calculator with support for matrix and vector math.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite --host 0.0.0.0",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaugustat/matrixer.git"
  },
  "keywords": [
