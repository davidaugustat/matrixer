  "bugs": {
    "url": "https://github.com/davidaugustat/matrixer/issues"
  },
  "homepage": "https://github.com/davidaugustat/matrixer#readme",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "katex": "^0.18.2",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "jsdom": "^26.1.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
