{
  "name": "matrixer",
  "version": "1.0.0",
  "description": "A simple finite field calculator with support for matrix and vector math.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt generate",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "serve:test": "node tests/staticServer.js",
    "test:logic": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:logic && npm run build && npm run test:e2e",
    "postinstall": "nuxt prepare"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidaugustat/matrixer.git"
  },
  "keywords": [
    "finite field",
    "vector",
    "matrix",
    "math"
  ],
  "author": "David Augustat",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/davidaugustat/matrixer/issues"
  },
  "homepage": "https://github.com/davidaugustat/matrixer#readme",
  "dependencies": {
    "katex": "^0.16.22",
    "nuxt": "^4.5.1",
    "vue": "^3.5.21",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "serve-handler": "^6.1.7",
    "vitest": "^4.1.11"
  }
}
